@page "/"
@using RailcarTrips.Database
@using RailcarTrips.Database.Models
@using Microsoft.EntityFrameworkCore
@inject RailcarTripsContext DbContext

<PageTitle>Trips</PageTitle>

<div class="py-8">
    <h1 class="text-4xl font-bold text-gray-900 mb-2">Railcar Trips</h1>
    <p class="text-gray-600 mb-6">View all recorded trips and their details</p>

    @if (trips == null)
    {
        <p class="text-gray-500">Loading trips...</p>
    }
    else if (trips.Count == 0)
    {
        <p class="text-gray-500">No trips found.</p>
    }
    else
    {
        <!-- Desktop Table View (hidden on small screens) -->
        <div class="hidden md:block overflow-x-auto">
            <table class="min-w-full bg-white border border-gray-200 rounded-lg shadow-sm">
                <thead class="bg-gray-100 border-b border-gray-200">
                    <tr>
                        <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Equipment</th>
                        <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Origin</th>
                        <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Destination</th>
                        <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Start Time</th>
                        <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">End Time</th>
                        <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Duration (Hours)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var trip in trips)
                    {
                        <tr class="border-b border-gray-200 hover:bg-gray-50">
                            <td class="px-6 py-4 text-sm text-gray-900 font-medium">@trip.EquipmentId</td>
                            <td class="px-6 py-4 text-sm text-gray-700">@trip.OriginCity?.Name</td>
                            <td class="px-6 py-4 text-sm text-gray-700">@trip.DestinationCity?.Name</td>
                            <td class="px-6 py-4 text-sm text-gray-700">@trip.StartUtc.ToString("g")</td>
                            <td class="px-6 py-4 text-sm text-gray-700">@trip.EndUtc.ToString("g")</td>
                            <td class="px-6 py-4 text-sm text-gray-700">@trip.TotalTripHours.ToString("F2") h</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Mobile Card View (visible only on small screens) -->
        <div class="md:hidden space-y-4">
            @foreach (var trip in trips)
            {
                <div class="bg-white border border-gray-200 rounded-lg p-4 shadow-sm">
                    <div class="flex justify-between items-start mb-3">
                        <h3 class="font-semibold text-gray-900">@trip.EquipmentId</h3>
                        <span class="text-xs bg-blue-100 text-blue-800 px-2 py-1 rounded">@trip.TotalTripHours.ToString("F2") h</span>
                    </div>
                    <div class="space-y-2 text-sm">
                        <div>
                            <span class="text-gray-500">From:</span> <span class="text-gray-900 font-medium">@trip.OriginCity?.Name</span>
                        </div>
                        <div>
                            <span class="text-gray-500">To:</span> <span class="text-gray-900 font-medium">@trip.DestinationCity?.Name</span>
                        </div>
                        <div>
                            <span class="text-gray-500">Departed:</span> <span class="text-gray-900">@trip.StartUtc.ToString("g")</span>
                        </div>
                        <div>
                            <span class="text-gray-500">Arrived:</span> <span class="text-gray-900">@trip.EndUtc.ToString("g")</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<Trip> trips = new();

    protected override async Task OnInitializedAsync()
    {
        trips = DbContext.Trips
            .Include(t => t.Equipment)
            .Include(t => t.OriginCity)
            .Include(t => t.DestinationCity)
            .OrderBy(t => t.EquipmentId)
            .ThenByDescending(t => t.StartUtc)
            .ToList();
    }
}
