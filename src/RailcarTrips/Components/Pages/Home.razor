@page "/"
@rendermode InteractiveServer
@using RailcarTrips.Database.Models
@using RailcarTrips.Trips
@inject TripsService TripsService

<PageTitle>Trips</PageTitle>

<div class="py-8 space-y-8">
    <!-- Upload Section -->
    <EventsUploadForm OnImportSuccess="RefreshTrips" />

    <!-- Trips Section -->
    <div>
        <h1 class="text-4xl font-bold text-gray-900 mb-2">Railcar Trips</h1>
        <p class="text-gray-600 mb-6">View all recorded trips and their details. Click a trip to view its events.</p>

        <TripsList Trips="trips" OnTripSelected="OpenModal" OnSort="SortBy" SortColumn="sortColumn" SortAscending="sortAscending" />
    </div>
</div>

<!-- Trip Details Modal Component -->
<TripDetailsModal Trip="selectedTrip" OnClose="CloseModal" />

@code {
    private List<Trip> trips = new();
    private Trip? selectedTrip = null;
    private string sortColumn = "Equipment";
    private bool sortAscending = true;

    protected override async Task OnInitializedAsync()
    {
        var allTrips = await TripsService.GetAllTripsAsync();
        trips = TripsService.SortTrips(allTrips, sortColumn, sortAscending);
    }

    private void SortBy(string column)
    {
        if (sortColumn == column)
        {
            sortAscending = !sortAscending;
        }
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
        trips = TripsService.SortTrips(trips, sortColumn, sortAscending);
    }

    private void OpenModal(Trip trip)
    {
        selectedTrip = trip;
    }

    private void CloseModal()
    {
        selectedTrip = null;
    }

    private async Task RefreshTrips()
    {
        var allTrips = await TripsService.GetAllTripsAsync();
        trips = TripsService.SortTrips(allTrips, sortColumn, sortAscending);
    }
}
