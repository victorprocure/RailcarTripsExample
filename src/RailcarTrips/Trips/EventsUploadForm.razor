@using RailcarTrips.Trips
@using Microsoft.AspNetCore.Components.Forms
@rendermode InteractiveServer

<div class="bg-white border border-gray-200 rounded-lg p-6 shadow-sm">
    <h2 class="text-xl font-bold text-gray-900 mb-4">Import Events</h2>
    <p class="text-gray-600 mb-6">Upload a CSV file with the schema: Equipment Id, Event Code, Event Time, City Id</p>

    @if (isUploading)
    {
        <div class="flex items-center justify-center py-8">
            <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600 mr-3"></div>
            <p class="text-gray-600">Importing events...</p>
        </div>
    }
    else
    {
        <div class="space-y-4">
            <div class="flex items-center justify-center w-full">
                <label for="csvFile" class="flex flex-col items-center justify-center w-full h-32 border-2 border-dashed border-gray-300 rounded-lg cursor-pointer bg-gray-50 hover:bg-gray-100 transition-colors">
                    <div class="flex flex-col items-center justify-center pt-5 pb-6">
                        <svg class="w-8 h-8 text-gray-500 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M9 19l3 3m0 0l3-3m-3 3V10"></path>
                        </svg>
                        <p class="text-sm text-gray-600"><span class="font-semibold">Click to upload</span> or drag and drop</p>
                        <p class="text-xs text-gray-500">CSV files only</p>
                    </div>
                    <InputFile id="csvFile" OnChange="@HandleFileSelected" accept=".csv" class="hidden" />
                </label>
            </div>

            @if (!string.IsNullOrEmpty(selectedFileName))
            {
                <div class="flex items-center justify-between bg-blue-50 border border-blue-200 rounded-lg p-3">
                    <span class="text-sm text-blue-900">📄 @selectedFileName</span>
                    <button @onclick="ClearFile" class="text-blue-600 hover:text-blue-800 font-semibold text-sm">Clear</button>
                </div>
            }

            @if (!string.IsNullOrEmpty(statusMessage))
            {
                <div class="rounded-lg p-4 @(isSuccess ? "bg-green-50 border border-green-200" : "bg-red-50 border border-red-200")">
                    <p class="text-sm @(isSuccess ? "text-green-800" : "text-red-800")">
                        @statusMessage
                    </p>
                </div>
            }

            <button 
                @onclick="UploadFile" 
                disabled="@(string.IsNullOrEmpty(selectedFileName) || isUploading)"
                class="w-full px-6 py-2 bg-blue-600 text-white rounded-lg font-semibold hover:bg-blue-700 disabled:bg-gray-400 disabled:cursor-not-allowed transition-colors">
                Import Events
            </button>
        </div>
    }
</div>

@code {
    [Parameter]
    public EventCallback OnImportSuccess { get; set; }

    @inject TripsImportService ImportService

    private string? selectedFileName;
    private IBrowserFile? selectedFile;
    private string? statusMessage;
    private bool isSuccess = false;
    private bool isUploading = false;

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        selectedFileName = selectedFile.Name;
        statusMessage = null;
        await Task.CompletedTask;
    }

    private void ClearFile()
    {
        selectedFile = null;
        selectedFileName = null;
        statusMessage = null;
    }

    private async Task UploadFile()
    {
        if (selectedFile == null)
            return;

        isUploading = true;
        statusMessage = null;

        try
        {
            using var stream = selectedFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024); // 10MB max
            var result = await ImportService.ImportEventsAsync(stream);

            statusMessage = result.Message;
            isSuccess = result.Success;

            if (result.Success)
            {
                selectedFile = null;
                selectedFileName = null;
                await OnImportSuccess.InvokeAsync();
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Error: {ex.Message}";
            isSuccess = false;
        }
        finally
        {
            isUploading = false;
        }
    }
}
