@using RailcarTrips.Database.Models
@rendermode InteractiveServer

@if (Trips == null)
{
    <p class="text-gray-500">Loading trips...</p>
}
else if (Trips.Count == 0)
{
    <p class="text-gray-500">No trips found.</p>
}
else
{
    <!-- Desktop Table View (hidden on small screens) -->
    <div class="hidden md:block overflow-x-auto">
        <table class="min-w-full bg-white border border-gray-200 rounded-lg shadow-sm">
            <thead class="bg-gray-100 border-b border-gray-200">
                <tr>
                    <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">
                        <button @onclick="@(() => OnSortBy("Equipment"))" class="hover:text-blue-600 flex items-center gap-1">Equipment @GetSortIcon("Equipment")</button>
                    </th>
                    <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">
                        <button @onclick="@(() => OnSortBy("Origin"))" class="hover:text-blue-600 flex items-center gap-1">Origin @GetSortIcon("Origin")</button>
                    </th>
                    <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">
                        <button @onclick="@(() => OnSortBy("Destination"))" class="hover:text-blue-600 flex items-center gap-1">Destination @GetSortIcon("Destination")</button>
                    </th>
                    <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">
                        <button @onclick="@(() => OnSortBy("StartTime"))" class="hover:text-blue-600 flex items-center gap-1">Start Time @GetSortIcon("StartTime")</button>
                    </th>
                    <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">
                        <button @onclick="@(() => OnSortBy("EndTime"))" class="hover:text-blue-600 flex items-center gap-1">End Time @GetSortIcon("EndTime")</button>
                    </th>
                    <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">
                        <button @onclick="@(() => OnSortBy("Duration"))" class="hover:text-blue-600 flex items-center gap-1">Duration (Hours) @GetSortIcon("Duration")</button>
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var trip in Trips)
                {
                    <tr class="border-b border-gray-200 hover:bg-gray-50">
                        <td class="px-6 py-4 text-sm">
                            <button @onclick="@(async () => await OnTripSelected.InvokeAsync(trip))" class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-3 rounded-lg transition-colors">@trip.EquipmentId <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg></button>
                        </td>
                        <td class="px-6 py-4 text-sm text-gray-700">@trip.OriginCity?.Name</td>
                        <td class="px-6 py-4 text-sm text-gray-700">@trip.DestinationCity?.Name</td>
                        <td class="px-6 py-4 text-sm text-gray-700">@trip.StartUtc.ToUniversalTime().ToString("g") Z</td>
                        <td class="px-6 py-4 text-sm text-gray-700">@trip.EndUtc.ToUniversalTime().ToString("g") Z</td>
                        <td class="px-6 py-4 text-sm text-gray-700">@trip.TotalTripHours.ToString("F2") h</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Mobile Card View (visible only on small screens) -->
    <div class="md:hidden space-y-4">
        @foreach (var trip in Trips)
        {
            <button @onclick="@(async () => await OnTripSelected.InvokeAsync(trip))" class="w-full text-left bg-white border border-gray-200 rounded-lg p-4 shadow-sm cursor-pointer hover:shadow-md transition-shadow hover:border-blue-300">
                <div class="flex justify-between items-start mb-3">
                    <h3 class="font-semibold text-gray-900">@trip.EquipmentId</h3>
                    <span class="text-xs bg-blue-100 text-blue-800 px-2 py-1 rounded">@trip.TotalTripHours.ToString("F2") h</span>
                </div>
                <div class="space-y-2 text-sm">
                    <div>
                        <span class="text-gray-500">From:</span> <span class="text-gray-900 font-medium">@trip.OriginCity?.Name</span>
                    </div>
                    <div>
                        <span class="text-gray-500">To:</span> <span class="text-gray-900 font-medium">@trip.DestinationCity?.Name</span>
                    </div>
                    <div>
                        <span class="text-gray-500">Departed:</span> <span class="text-gray-900">@trip.StartUtc.ToUniversalTime().ToString("g") Z</span>
                    </div>
                    <div>
                        <span class="text-gray-500">Arrived:</span> <span class="text-gray-900">@trip.EndUtc.ToUniversalTime().ToString("g") Z</span>
                    </div>
                </div>
            </button>
        }
    </div>
}

@code {
    [Parameter]
    public List<Trip>? Trips { get; set; }

    [Parameter]
    public EventCallback<Trip> OnTripSelected { get; set; }

    [Parameter]
    public EventCallback<string> OnSort { get; set; }

    [Parameter]
    public string SortColumn { get; set; } = "Equipment";

    [Parameter]
    public bool SortAscending { get; set; } = true;

    private async Task OnSortBy(string column)
    {
        await OnSort.InvokeAsync(column);
    }

    private string GetSortIcon(string column)
    {
        if (SortColumn != column)
            return "↕️";
        
        return SortAscending ? "↑" : "↓";
    }
}
